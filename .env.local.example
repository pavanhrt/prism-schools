# Copy to .env.local and fill in from your Supabase project's
# Settings -> API page (see blueprint §28.1 — Supabase Cloud, managed).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_, never import outside
# lib/supabase/admin.ts (guarded by the "server-only" package).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phase 5 — Razorpay. key_id is not secret (the portal's Pay Now button
# receives it from the server action), key_secret and the webhook secret
# are. Without these, invoice generation/collection still works — only
# the online-payment path is affected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phase 7 — Resend, for features/communication's "Send Email" action.
# Without these, notices/templates still work — only actual sending does.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@yourschool.example

# Phase 9 — used by app/sitemap.ts and app/robots.ts to build absolute
# URLs. Safe to leave unset for local dev; set it to your real domain
# once deployed.
NEXT_PUBLIC_SITE_URL=https://prismschoolnew.netlify.app
